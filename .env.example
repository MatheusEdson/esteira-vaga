# Porta local do app
PORT=8099

# Gate da instancia publicada (ver deploy/nginx.conf).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(16))"
ESTEIRA_KEY=troque-esta-chave

# Playwright: em maquina com C: cheio, aponte o temp para outro disco
# TEMP=D:/esteira-vagas/_tmp

# --- esteira de e-mail (tools/esteira) ---
GMAIL_CLIENT_SECRET=caminho/para/gmail-oauth-client.json
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
MEUS_EMAILS=voce@gmail.com,voce@empresa.com
AVISO_PARA=voce@gmail.com
BREVO_API_KEY_ESTEIRA=
BREVO_SENDER_ESTEIRA=

# credencial de portal de vaga (nunca no codigo)
NEAR_SENHA=

# --- navegador (nav.py, core/, tools/upwork) ---
# Canal do Chromium usado pelo patchright. "msedge" e "chrome" usam o binario instalado
# na maquina, que passa em desafio de bot onde o Chromium baixado pelo Playwright falha.
VAGAS_CANAL=msedge

# Porta de depuracao do navegador que VOCE abre a mao. A automacao conecta nela, nunca
# lanca o processo: quem abre o browser decide se o desafio de bot aparece.
UPW_PORTA=9333

# Perfil persistente do Edge para o login manual (core/login_linkedin.py).
# Padrao: data/_perfil-edge dentro do repo, que e gitignored.
# PERFIL_EDGE=

# Credencial de portal de vaga usada por core/abrir_sessao.py. Vazio faz a janela abrir
# para voce digitar a mao, que e o comportamento seguro.
VAGAS_LOGIN=
VAGAS_SENHA=

# --- infra ---
# Qual arquivo .env o tools/esteira/db.py carrega. So mude se rodar varios ambientes.
# ENV_FILE=.env
